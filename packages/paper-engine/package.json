{
  "name": "@cip/paper-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Practice trading (ADR 021): the order rules, the fill model (book walks, trades through the price, stops and targets) and the balance ledger, as a deterministic reducer. Shared by the broker (live) and the api (order checks). Pure: no I/O, no framework.",
  "exports": {
    ".": {
      "@cip/source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --config-file ../../.swcrc --ignore \"**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cip/contracts": "workspace:*",
    "@cip/domain": "workspace:*"
  },
  "devDependencies": {
    "@cip/config": "workspace:*",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fast-check": "catalog:",
    "vitest": "catalog:"
  }
}
