{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Everything the main window may call, and nothing more (architecture §13). No shell, file system, HTTP or autostart access.",
  "windows": ["main"],
  "permissions": [
    "core:app:allow-version",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    },
    "window-state:default",
    "allow-secure-store-get",
    "allow-secure-store-set",
    "allow-secure-store-delete",
    "allow-set-tray-status"
  ]
}
