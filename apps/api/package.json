{
  "name": "@cip/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "REST API and live channels: authentication, RBAC, audit logging, market data, administration and system health.",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --config-file ../../.swcrc --ignore \"**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.int.config.ts",
    "dev": "node --env-file-if-exists=.env --watch --conditions=@cip/source --import @swc-node/register/esm-register src/main.ts",
    "start": "node dist/main.js",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "@cip/contracts": "workspace:*",
    "@cip/db": "workspace:*",
    "@cip/domain": "workspace:*",
    "@cip/exchange-adapters": "workspace:*",
    "@cip/observability": "workspace:*",
    "@cip/smc-engine": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@node-rs/argon2": "catalog:",
    "@opentelemetry/api": "catalog:",
    "bullmq": "catalog:",
    "cookie-parser": "catalog:",
    "express": "catalog:",
    "helmet": "catalog:",
    "ioredis": "catalog:",
    "jose": "catalog:",
    "kysely": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "socket.io": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cip/config": "workspace:*",
    "@nestjs/testing": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/cookie-parser": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "socket.io-client": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
