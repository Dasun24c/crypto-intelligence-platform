# Copy to apps/api/.env for `pnpm --filter @cip/api dev` against the local stack's database and Valkey
# (start them with `docker compose up --wait db valkey migrate`). Secrets come from ./.secrets.
NODE_ENV=development
LOG_PRETTY=true
API_PORT=3001
OPS_PORT=9564
DATABASE_URL_FILE=../../.secrets/db-url-host-svc_api
REDIS_URL=redis://localhost:16379
AUTH_JWT_PRIVATE_KEY_FILE=../../.secrets/jwt-ed25519.pem
MFA_ENCRYPTION_KEY_FILE=../../.secrets/mfa-key
CORS_ORIGINS=http://localhost:5173,http://localhost:1420
